# Copy to mcp.env on the server, fill in, then: chmod 600 mcp.env
# Never commit the real file.
# Used by every tool Claude can call. Must NOT have send permission.
LISTMONK_TOKEN=claude_cmo_read:REPLACE_ME
# Used ONLY when a human clicks an approval link.
LISTMONK_SEND_TOKEN=claude_cmo_send:REPLACE_ME
# python3 -c 'import secrets; print(secrets.token_urlsafe(36))'
MCP_PATH_SECRET=REPLACE_ME
