#!/bin/sh
# Blocks pushes whose commits contain a secret, even ones made with --no-verify.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                            # new branch: scan its full history
  else
    range="$remote_sha..$local_sha"
  fi
  python3 "$root/scripts/secret_scan.py" --range "$range" || status=1
done
exit $status
